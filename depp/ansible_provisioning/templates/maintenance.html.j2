<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- Auto-retry: the pod is only down for the brief deploy cutover. -->
    <meta http-equiv="refresh" content="5">
    <title>Deployment in progress</title>
    <style>
        body {
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            background: #f6f7f9;
            color: #1f2933;
            display: flex;
            min-height: 100vh;
            margin: 0;
            align-items: center;
            justify-content: center;
        }
        main {
            max-width: 32rem;
            padding: 2.5rem;
            text-align: center;
        }
        h1 { font-size: 1.5rem; margin-bottom: 0.75rem; }
        p { color: #52606d; line-height: 1.5; }
        .spinner {
            width: 2.5rem;
            height: 2.5rem;
            margin: 0 auto 1.5rem;
            border: 3px solid #d9e2ec;
            border-top-color: #3e4c59;
            border-radius: 50%;
            animation: spin 0.9s linear infinite;
        }
        @keyframes spin { to { transform: rotate(360deg); } }
    </style>
</head>
<body>
    <main>
        <div class="spinner" role="status" aria-label="Loading"></div>
        <h1>Deployment in progress</h1>
        <p>We're rolling out a new version and will be back in a moment.
           This page refreshes automatically.</p>
    </main>
</body>
</html>
