# Copy to .env-prod and fill in real values. depp renders this into the
# "wagtail-demo-config" ConfigMap and injects it into every container that
# references it via envFrom (see container/kube.yaml). The app and the db
# container share this single ConfigMap.

# --- Django / Wagtail ---
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=wagtail-demo.example.com,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://wagtail-demo.example.com
WAGTAILADMIN_BASE_URL=https://wagtail-demo.example.com

# --- Postgres (read by the postgres container) ---
POSTGRES_DB=wagtail
POSTGRES_USER=wagtail
POSTGRES_PASSWORD=replace-with-a-strong-password

# --- Database URL (read by the app). Password MUST match POSTGRES_PASSWORD.
# Containers in a pod share localhost, so the db is reachable at 127.0.0.1:5432.
DATABASE_URL=postgres://wagtail:replace-with-a-strong-password@127.0.0.1:5432/wagtail
